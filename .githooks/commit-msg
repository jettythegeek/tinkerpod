#!/usr/bin/env sh
set -eu

MSG_FILE="${1:-}"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  echo "ERROR: commit-msg hook requires a commit message file path." >&2
  exit 1
fi

AUTHOR_NAME="${GIT_AUTHOR_NAME:-$(git config user.name || true)}"
AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-$(git config user.email || true)}"
COMMITTER_NAME="${GIT_COMMITTER_NAME:-$(git config user.name || true)}"
COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$(git config user.email || true)}"

if [ "$AUTHOR_NAME" != "jettythegeek" ]; then
  echo "ERROR: Commit author name must be 'jettythegeek' (got '${AUTHOR_NAME}')." >&2
  exit 1
fi

if [ "$COMMITTER_NAME" != "jettythegeek" ]; then
  echo "ERROR: Committer name must be 'jettythegeek' (got '${COMMITTER_NAME}')." >&2
  exit 1
fi

case "$AUTHOR_EMAIL" in
  *jettythegeek*) ;;
  *)
    echo "ERROR: Commit author email must belong to jettythegeek (got '${AUTHOR_EMAIL}')." >&2
    exit 1
    ;;
esac

case "$COMMITTER_EMAIL" in
  *jettythegeek*) ;;
  *)
    echo "ERROR: Committer email must belong to jettythegeek (got '${COMMITTER_EMAIL}')." >&2
    exit 1
    ;;
esac

if grep -iqE '(^|[[:space:]])co-authored-by:' "$MSG_FILE"; then
  echo "ERROR: 'Co-authored-by' trailers are forbidden in this repository." >&2
  exit 1
fi

if grep -iqE '(cursoragent|cursor agent)' "$MSG_FILE"; then
  echo "ERROR: Bot attribution in commit messages is forbidden." >&2
  exit 1
fi

exit 0
